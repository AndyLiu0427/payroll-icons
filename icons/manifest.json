{
  "$comment": "Metadata for every authored master. Geometry lives in the .svg files; this file says what each mark means and how it may be used. The build reads this to decide what to generate.",

  "grid": {
    "canvas": 24,
    "liveArea": 20,
    "strokeWidth": 1.5,
    "modifierCentre": [17.5, 17.5],
    "modifierRadius": 4.25,
    "knockoutRadius": 5.5
  },

  "bases": {
    "payslip": {
      "zh": "薪資單",
      "group": "documents",
      "composable": true,
      "tier": "free",
      "fill": { "container": 0 }
    },
    "invoice": {
      "zh": "發票 / 請款單",
      "group": "documents",
      "composable": true,
      "tier": "free",
      "fill": { "container": 0 }
    },
    "contract": {
      "zh": "合約",
      "group": "documents",
      "composable": true,
      "tier": "free",
      "fill": { "container": 0 }
    },
    "tax-form": {
      "zh": "稅務表單 / 扣繳",
      "group": "documents",
      "composable": true,
      "tier": "free",
      "fill": { "container": 0 }
    },
    "statement": {
      "zh": "對帳單",
      "group": "documents",
      "composable": false,
      "tier": "free",
      "note": "full-width bar chart runs into the modifier zone",
      "fill": { "container": 0 }
    },
    "documents": {
      "zh": "多筆文件 / 批次",
      "group": "documents",
      "composable": true,
      "tier": "free"
    },
    "receipt": {
      "zh": "收據",
      "group": "documents",
      "composable": true,
      "tier": "free",
      "fill": { "container": 0 }
    },
    "ledger": {
      "zh": "總帳 / 帳冊",
      "group": "documents",
      "composable": true,
      "tier": "free",
      "note": "no derivable filled form — the spine follows the container edge, so knocking it out bites the silhouette, and skipping it leaves a shape indistinguishable from a filled invoice"
    },

    "timesheet": {
      "zh": "出勤工時",
      "group": "time",
      "composable": true,
      "tier": "free",
      "conflicts": ["pending"]
    },
    "calendar": { "zh": "日曆 / 期間", "group": "time", "composable": true, "tier": "free" },
    "clock": {
      "zh": "工時 / 時數",
      "group": "time",
      "composable": true,
      "tier": "free",
      "conflicts": ["pending"],
      "fill": { "container": 0 }
    },

    "coin": {
      "zh": "金額 / 幣值",
      "group": "money",
      "composable": true,
      "tier": "free",
      "fill": { "container": 0 }
    },
    "banknote": {
      "zh": "現金 / 鈔票",
      "group": "money",
      "composable": false,
      "tier": "free",
      "note": "wide and short — knockout eats a run of the bottom edge, not a corner",
      "fill": { "container": 0 }
    },
    "bank": { "zh": "銀行 / 帳戶", "group": "money", "composable": true, "tier": "free" },
    "exchange": {
      "zh": "匯率 / 多幣別",
      "group": "money",
      "composable": false,
      "tier": "free",
      "note": "arrows span the full width"
    },
    "balance": {
      "zh": "對帳 / 平衡",
      "group": "money",
      "composable": false,
      "tier": "free",
      "note": "right pan and base sit in the modifier zone"
    },

    "shield": {
      "zh": "法定給付 / 保險",
      "group": "statutory",
      "composable": true,
      "tier": "free",
      "fill": { "container": 0 }
    },

    "employee": { "zh": "員工", "group": "organisation", "composable": true, "tier": "free" },
    "team": {
      "zh": "團隊 / 人數",
      "group": "organisation",
      "composable": false,
      "tier": "free",
      "note": "second figure occupies the modifier zone"
    },
    "org-chart": {
      "zh": "部門 / 成本中心",
      "group": "organisation",
      "composable": false,
      "tier": "free",
      "note": "right child node sits in the modifier zone"
    },

    "pay-run": { "zh": "薪資批次", "group": "process", "composable": true, "tier": "free" }
  },

  "modifiers": {
    "approved": { "zh": "已核准 / 已付", "tier": "free" },
    "pending": { "zh": "待處理", "tier": "free", "glyph": "clock" },
    "recurring": { "zh": "週期性", "tier": "free" },
    "exception": { "zh": "異常 / 需查核", "tier": "free" },
    "locked": { "zh": "已關帳 / 鎖定", "tier": "free" },
    "down": { "zh": "扣除 / 支出", "tier": "free" },
    "up": { "zh": "加給 / 收入", "tier": "free" },
    "plus": { "zh": "新增 / 加項", "tier": "free" },
    "minus": { "zh": "移除 / 減項", "tier": "free" }
  },

  "$comment_currency": "Currency coins are named by symbol, not by ISO code: a dollar sign cannot distinguish USD from SGD from AUD, and an icon that claims to would be lying. `covers` records which currencies each mark legitimately stands for — use it to drive a picker, and let the product label carry the actual code. All of these are display-only: the glyph fills the coin, so there is no room for a badge, and you would badge the generic `coin` anyway.",

  "currencies": {
    "dollar": {
      "zh": "美元 / 新幣 / 澳幣",
      "symbol": "$",
      "covers": ["USD", "SGD", "AUD", "HKD", "TWD", "NZD", "CAD"],
      "tier": "pro"
    },
    "euro": { "zh": "歐元", "symbol": "€", "covers": ["EUR"], "tier": "pro" },
    "pound": { "zh": "英鎊", "symbol": "£", "covers": ["GBP"], "tier": "pro" },
    "yen": { "zh": "日圓 / 人民幣", "symbol": "¥", "covers": ["JPY", "CNY"], "tier": "pro" },
    "peso": { "zh": "菲律賓披索", "symbol": "₱", "covers": ["PHP"], "tier": "pro" },
    "dong": { "zh": "越南盾", "symbol": "₫", "covers": ["VND"], "tier": "pro" },
    "baht": { "zh": "泰銖", "symbol": "฿", "covers": ["THB"], "tier": "pro" },
    "ringgit": {
      "zh": "馬幣",
      "symbol": "RM",
      "covers": ["MYR"],
      "tier": "pro",
      "note": "two letters — no 16px master, falls back to the 24px one"
    },
    "rupiah": {
      "zh": "印尼盾",
      "symbol": "Rp",
      "covers": ["IDR"],
      "tier": "pro",
      "note": "two letters — no 16px master, falls back to the 24px one"
    }
  },

