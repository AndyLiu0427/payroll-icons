{
  "name": "@octomate/payroll-icons",
  "version": "0.2.0",
  "description": "Payroll, time, statutory and billing icons built from a base × modifier system. 24×24, stroke, currentColor, animation-ready.",
  "keywords": [
    "icons",
    "svg",
    "react",
    "payroll",
    "billing",
    "invoice",
    "hr",
    "fintech"
  ],
  "license": "MIT",
  "author": "YingYen Liu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndyLiu0427/payroll-icons.git"
  },
  "bugs": {
    "url": "https://github.com/AndyLiu0427/payroll-icons/issues"
  },
  "homepage": "https://andyliu0427.github.io/payroll-icons/",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./angular": {
      "types": "./dist/generated/angular.d.ts",
      "default": "./dist/generated/angular.js"
    },
    "./registry": {
      "types": "./dist/generated/registry.d.ts",
      "default": "./dist/generated/registry.js"
    },
    "./concepts": {
      "types": "./dist/generated/concepts.d.ts",
      "default": "./dist/generated/concepts.js"
    },
    "./paths": {
      "types": "./dist/generated/paths.d.ts",
      "default": "./dist/generated/paths.js"
    },
    "./animate.css": "./dist/animate.css",
    "./svg/*": "./dist/svg/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "icons": "node scripts/build.mjs",
    "icons:core": "node scripts/build.mjs --set core",
    "figma": "npm run icons && node scripts/figma-export.mjs",
    "confusability": "node scripts/confusability.mjs",
    "shapes": "node scripts/shapes.mjs",
    "prebuild": "npm run icons",
    "build": "ngc -p tsconfig.build.json && cp src/animate.css dist/animate.css",
    "smoke": "node scripts/smoke.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:core": "npm run icons:core && ngc -p tsconfig.build.json && cp src/animate.css dist/animate.css",
    "dev": "npm run icons && vite --config vite.config.demo.ts",
    "demo:build": "npm run icons && vite build --config vite.config.demo.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "prepublishOnly": "npm run build && npm test && npm run smoke"
  },
  "peerDependencies": {
    "@angular/core": ">=18",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/common": "^21.2.19",
    "@angular/compiler": "^22.1.2",
    "@angular/compiler-cli": "^21.2.19",
    "@angular/core": "^21.2.19",
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "svgo": "^4.0.0",
    "typescript": "5.9",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "zone.js": "^0.16.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
